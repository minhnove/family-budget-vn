# Điền trên Vercel → Project → Settings → Environment Variables (KHÔNG commit file .env thật)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # Supabase → Project Settings → API → service_role (bí mật!)
FAMILY_PASSWORD=                            # mật khẩu chung của gia đình để vào app (>= 10 ký tự)
SESSION_SECRET=                             # chuỗi ngẫu nhiên >= 32 ký tự
TELEGRAM_TOKEN=                             # token từ @BotFather
TELEGRAM_WEBHOOK_SECRET=                    # chuỗi ngẫu nhiên >= 32 ký tự (chỉ chữ, số, _ và -)
CRON_SECRET=                                # chuỗi ngẫu nhiên >= 32 ký tự, Vercel dùng để gọi /api/cron
# APP_URL=https://ten-app.vercel.app        # (tuỳ chọn) địa chỉ app, dùng khi đăng ký webhook Telegram
